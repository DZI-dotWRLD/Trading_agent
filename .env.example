# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=

# Mailbox the service watches and sends from (Gmail: create an app password under
# Google Account > Security > App passwords; 2-step verification must be on).
MAIL_USER=
MAIL_APP_PASSWORD=

# Microsoft 365 instead (mailbox.type: graph in config.yaml): MAIL_USER is the mailbox address,
# and IT's app registration supplies these (docs/NEXT_STEPS.md, section 3). No app password needed.
# GRAPH_TENANT_ID=
# GRAPH_CLIENT_ID=
# GRAPH_CLIENT_SECRET=

# Optional
VSCP_MODEL=claude-sonnet-5-5            # the weekly build
VSCP_DISCOVERY_MODEL=claude-opus-5-5   # learning a new company's file layout
# VSCP_MAX_BUDGET_USD=5            # per-run spend cap for the agent
# VSCP_RECALC_ENGINE=libreoffice   # or excel; default: LibreOffice if installed, else Excel
